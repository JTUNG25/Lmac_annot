process {
    executor    = 'slurm'
    queue       = 'general'
    time        = '12h'
    cpus        = 8
    memory      = '32 GB'
    clusterOptions = '--account=a_qaafi_chs --qos=normal'

    withLabel: gpu {
        queue          = 'gpu_cuda'
        cpus           = 8
        memory         = '64 GB'
        time           = '24h'
        clusterOptions = '--account=a_qaafi_chs --qos=gpu --gres=gpu:h100:1'
        containerOptions = '--nv'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
}

workDir = '/scratch/user/uqctung/nextflow_work'

env {
    APPTAINER_TMPDIR  = '/scratch/user/uqctung/tmp'
    APPTAINER_CACHEDIR = '/scratch/user/uqctung/cache'
}